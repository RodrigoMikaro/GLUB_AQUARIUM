#include <WiFi.h>
#include <WiFiClientSecure.h>
#include <PubSubClient.h>
#include <WebServer.h>
#include <Preferences.h>
#include <Wire.h>
#include <INA226_WE.h>
#include "time.h"

// Bibliotecas do Sensor de Temperatura DS18B20
#include <OneWire.h>
#include <DallasTemperature.h>

// Biblioteca do Servo Motor para ESP32
#include <ESP32Servo.h>

// ======================================================
// SENSOR DE TEMPERATURA DS18B20
// ======================================================
const int PINO_DS18B20 = 16;
OneWire oneWire(PINO_DS18B20);
DallasTemperature sensorTemp(&oneWire);

float temperaturaAgua = 0.0;

// ======================================================
// INA226
// ======================================================
#define I2C_ADDRESS 0x40

INA226_WE ina226 = INA226_WE(I2C_ADDRESS);

const int PIN_SDA = 21;
const int PIN_SCL = 22;

// ======================================================
// MQTT
// ======================================================
const char* mqtt_server = "0e6bf66e693b43c2a87b5cd707fe5647.s1.eu.hivemq.cloud";
const int mqtt_port = 8883;

const char* mqtt_user = "glub1";
const char* mqtt_pass = "GlubAquarium1";

const char* topic_led             = "glub1/led";
const char* topic_voltagem         = "glub1/voltagem";
const char* topic_troca            = "glub1/troca";
const char* topic_status           = "glub1/troca/status";
const char* topic_distancia        = "glub1/distancia";
const char* topic_temperatura      = "glub1/temperatura";     
const char* topic_temperatura_set  = "glub1/temperatura/set"; 
const char* topic_alimentacao_freq = "glub1/alimentacao/frequencia";
const char* topic_alimentacao_agora= "glub1/alimentacao/agora";      

// ======================================================
// PINOS
// ======================================================
const int ledPin = 2;

const int BOMBA_ENCHER   = 32;
const int BOMBA_ESVAZIAR = 33;

const int TRIG_PIN = 25;
const int ECHO_PIN = 26;

const int TERMOSTATO = 17; 
const int VENTOINHA  = 18; 

const int PINO_SERVO = 23; 

// ======================================================
// SERVO E ALIMENTAÇÃO
// ======================================================
Servo servoAlimentador;

int frequenciaAlimentacao = 1; // 1 vez ao dia por padrão
unsigned long ultimaAlimentacao = 0;

// ======================================================
// ULTRASSÔNICO
// ======================================================
const float TEMP_C = 20.0; 

float distancia_Per_uSec;

const int NUM_LEITURAS = 10;
float leituras[NUM_LEITURAS];
float soma = 0;
int indice = 0;
int leiturasValidas = 0;

float distanciaCm = 0;
float distanciaMediaCm = 0;

const float DISTANCIA_MAX_RESERVATORIO_SUJO_CM = 28.0;

// ======================================================
// TEMPOS
// ======================================================
unsigned long anteriorMillisMQTT = 0;
unsigned long anteriorMillisWiFi = 0;

unsigned long anteriorMillisUltrassom = 0;
unsigned long anteriorMillisTelemetria = 0;
unsigned long anteriorMillisTemp = 0;

const unsigned long intervaloUltrassom = 100;
const unsigned long intervaloTelemetria = 1000;
const unsigned long intervaloTemp = 2000; 

// segurança
const unsigned long TEMPO_MAX_DRENAGEM   = 180000;
const unsigned long TEMPO_MAX_ENCHIMENTO = 180000;

// ======================================================
// VARIÁVEIS E CONTROLE TÉRMICO
// ======================================================
WebServer server(80);
WiFiClientSecure espClient;
PubSubClient client(espClient);
Preferences preferences;

String rede_local = "";
String senha_local = "";

float voltagem = 0.0;

unsigned long tempoTrocaAprendido = 0;

float temperaturaDesejada = 25.0; 
bool aquecendo = false;
bool resfriando = false;

// ======================================================
// ESTADOS
// ======================================================
enum EstadoTroca {
  IDLE,
  DRENANDO,
  ENCHENDO
};

EstadoTroca estadoTroca = IDLE;
bool trocaAtiva = false;
unsigned long inicioEtapa = 0;

// ======================================================
// PORTAL WIFI
// ======================================================
void handleRoot() {
  String html;
  html += "<html><body style='text-align:center;font-family:sans-serif;'>";
  html += "<h2>Configurar WiFi - GLUB</h2>";
  html += "<form action='/save' method='POST'>";
  html += "Rede: <input type='text' name='ssid'><br><br>";
  html += "Senha: <input type='password' name='pass'><br><br>";
  html += "<input type='submit' value='Salvar'>";
  html += "</form></body></html>";

  server.send(200, "text/html", html);
}

void handleSave() {
  preferences.begin("wifi-config", false);
  preferences.putString("ssid", server.arg("ssid"));
  preferences.putString("pass", server.arg("pass"));
  preferences.end();

  server.send(200, "text/html", "Salvo! Reiniciando...");
  delay(2000);
  ESP.restart();
}

// ======================================================
// NTP
// ======================================================
void sincronizarHora() {
  configTime(0, 0, "pool.ntp.org", "time.nist.gov");
  time_t now = time(nullptr);
  int tentativas = 0;

  while(now < 8 * 3600 * 2 && tentativas < 20) {
    delay(500);
    now = time(nullptr);
    tentativas++;
  }
}

// ======================================================
// RELÉS E BOMBAS
// ======================================================
const int RELE_ON  = HIGH;
const int RELE_OFF = LOW;

void desligarBombas() {
  digitalWrite(BOMBA_ENCHER, RELE_OFF);
  digitalWrite(BOMBA_ESVAZIAR, RELE_OFF);
}

void ligarBombaEncher() {
  digitalWrite(BOMBA_ESVAZIAR, RELE_OFF);
  digitalWrite(BOMBA_ENCHER, RELE_ON);
}

void ligarBombaEsvaziar() {
  digitalWrite(BOMBA_ENCHER, RELE_OFF);
  digitalWrite(BOMBA_ESVAZIAR, RELE_ON);
}

// ======================================================
// MQTT STATUS
// ======================================================
void publicarStatus(const char* msg) {
  if(client.connected()) {
    client.publish(topic_status, msg, true);
  }
}

// ======================================================
// ALIMENTAÇÃO AUTOMÁTICA
// ======================================================
void realizarAlimentacao() {
  Serial.println("Iniciando alimentacao (Simulando ida e volta no motor 360)...");

  // 1. GIRA PARA FRENTE (Simulando a ida)
  servoAlimentador.write(180); // Velocidade máxima para um lado
  delay(1000); 

  // 2. PAUSA RÁPIDA NO FINAL DO CURSO
  servoAlimentador.write(90); // Ponto morto (parado)
  delay(500); // Fica parado meio segundo para a ração cair

  // 3. GIRA PARA TRÁS (Simulando a volta para a posição inicial)
  servoAlimentador.write(0);  // Velocidade máxima para o lado oposto
  delay(1000); 

  // 4. PONTO MORTO (Para o motor definitivamente)
  servoAlimentador.write(90);
  
  Serial.println("Alimentacao concluida. Motor parado.");
  
  // O ultimaAlimentacao = millis() foi removido daqui para evitar perda de fase!
}

void atualizarRotinaAlimentacao() {
  // Se a frequência for 0, o agendamento automático está desligado
  if (frequenciaAlimentacao <= 0) return;

  // Calcula o intervalo em milissegundos baseado em 24h
  unsigned long intervaloMs = (24UL * 60 * 60 * 1000) / frequenciaAlimentacao;

  // Verifica se o tempo transcorrido é maior que o intervalo
  if (millis() - ultimaAlimentacao >= intervaloMs) {
    realizarAlimentacao();
    
    // Ajuste simples e perfeito para corrigir o desvio de tempo:
    // Adicionamos o intervalo fixo para o cronômetro ignorar o tempo gasto pelo servo.
    ultimaAlimentacao += intervaloMs;
    
    // Trava de segurança caso o sistema fique inativo por mais tempo que o intervalo:
    if (millis() - ultimaAlimentacao > intervaloMs) {
      ultimaAlimentacao = millis();
    }
  }
}

// ======================================================
// SENSORES
// ======================================================
void atualizarUltrassom() {
  if(millis() - anteriorMillisUltrassom < intervaloUltrassom) return;
  anteriorMillisUltrassom = millis();

  digitalWrite(TRIG_PIN, LOW);
  delayMicroseconds(2);
  digitalWrite(TRIG_PIN, HIGH);
  delayMicroseconds(15);
  digitalWrite(TRIG_PIN, LOW);

  long duration = pulseIn(ECHO_PIN, HIGH, 15000);

  if(duration > 0 && duration < 25000) {
    distanciaCm = (duration / 2.0) * distancia_Per_uSec;

    if(leiturasValidas < NUM_LEITURAS) {
      leituras[indice] = distanciaCm;
      soma += distanciaCm;
      leiturasValidas++;
    } else {
      soma -= leituras[indice];
      leituras[indice] = distanciaCm;
      soma += distanciaCm;
    }

    indice = (indice + 1) % NUM_LEITURAS;
    distanciaMediaCm = soma / leiturasValidas;
  }
}

void tratarSensorINA226() {
  voltagem = ina226.getBusVoltage_V();
}

void tratarSensorTemperatura() {
  if(millis() - anteriorMillisTemp < intervaloTemp) return;
  anteriorMillisTemp = millis();

  float tempLeitura = sensorTemp.getTempCByIndex(0);
  if (tempLeitura != DEVICE_DISCONNECTED_C) {
    temperaturaAgua = tempLeitura;
  }
  sensorTemp.requestTemperatures();
}

void atualizarControleTermico() {
  if (temperaturaAgua <= 0.0 || temperaturaAgua == 85.0) return; 

  float tMin = temperaturaDesejada - 1.0;
  float tMax = temperaturaDesejada + 1.0;

  if (temperaturaAgua <= tMin) {
    aquecendo = true;
    resfriando = false; 
  } 
  else if (temperaturaAgua >= temperaturaDesejada && aquecendo) {
    aquecendo = false;
  }

  if (temperaturaAgua >= tMax) {
    resfriando = true;
    aquecendo = false; 
  } 
  else if (temperaturaAgua <= temperaturaDesejada && resfriando) {
    resfriando = false;
  }

  digitalWrite(TERMOSTATO, aquecendo ? RELE_ON : RELE_OFF);
  digitalWrite(VENTOINHA, resfriando ? RELE_ON : RELE_OFF);
}

// ======================================================
// TELEMETRIA MQTT
// ======================================================
void publicarTelemetriaMQTT() {
  if(millis() - anteriorMillisTelemetria < intervaloTelemetria) return;
  anteriorMillisTelemetria = millis();

  if(!client.connected()) return;

  char bufferVolt[10];
  dtostrf(voltagem, 4, 2, bufferVolt);
  client.publish(topic_voltagem, bufferVolt, true);

  char bufferDist[10];
  dtostrf(distanciaMediaCm, 4, 1, bufferDist);
  client.publish(topic_distancia, bufferDist, true);

  char bufferTemp[10];
  dtostrf(temperaturaAgua, 4, 2, bufferTemp);
  client.publish(topic_temperatura, bufferTemp, true);
}

// ======================================================
// TROCA DE ÁGUA
// ======================================================
void iniciarTrocaAgua() {
  if(trocaAtiva) return;
  trocaAtiva = true;
  estadoTroca = DRENANDO;
  inicioEtapa = millis();
  ligarBombaEsvaziar();
  publicarStatus("drenando");
  Serial.println("Iniciando drenagem...");
}

void finalizarTroca() {
  desligarBombas();
  estadoTroca = IDLE;
  trocaAtiva = false;
  publicarStatus("concluido");
  Serial.println("Troca concluida.");
}

void atualizarTrocaAgua() {
  if(!trocaAtiva) return;
  unsigned long agora = millis();

  if(estadoTroca == DRENANDO) {
    bool atingiuNivel = (distanciaMediaCm >= 24.0 && distanciaMediaCm <= 28.0);
    bool timeout = (agora - inicioEtapa >= TEMPO_MAX_DRENAGEM);

    if(atingiuNivel || timeout) {
      if(atingiuNivel) {
        tempoTrocaAprendido = agora - inicioEtapa;
        preferences.begin("troca", false);
        preferences.putULong("tempo", tempoTrocaAprendido);
        preferences.end();
      }
      desligarBombas();
      ligarBombaEncher();
      estadoTroca = ENCHENDO;
      inicioEtapa = millis();
      publicarStatus("enchendo");
    }
  }
  else if(estadoTroca == ENCHENDO) {
    unsigned long tempoUsado = (tempoTrocaAprendido > 0) ? tempoTrocaAprendido : 30000;
    bool terminou = (agora - inicioEtapa >= tempoUsado);
    bool timeout  = (agora - inicioEtapa >= TEMPO_MAX_ENCHIMENTO);

    if(terminou || timeout) finalizarTroca();
  }
}

// ======================================================
// CONEXÕES
// ======================================================
void manterConexoes() {
  if(WiFi.status() != WL_CONNECTED) {
    if(millis() - anteriorMillisWiFi >= 10000) {
      WiFi.begin(rede_local.c_str(), senha_local.c_str());
      anteriorMillisWiFi = millis();
    }
    return;
  }

  if(!client.connected()) {
    if(millis() - anteriorMillisMQTT >= 10000) {
      String clientId = "ESP32_GLUB_" + String(random(0xffff), HEX);
      if(client.connect(clientId.c_str(), mqtt_user, mqtt_pass)) {
        client.subscribe(topic_led);
        client.subscribe(topic_troca);
        client.subscribe(topic_temperatura_set);
        client.subscribe(topic_alimentacao_freq); // Tópico de frequência
        client.subscribe(topic_alimentacao_agora); // Tópico de trigger manual
        Serial.println("MQTT conectado!");
      }
      anteriorMillisMQTT = millis();
    }
  }
}

// ======================================================
// CALLBACK MQTT
// ======================================================
void callback(char* topic, byte* payload, unsigned int length) {
  String msg;
  for(int i = 0; i < length; i++) {
    msg += (char)payload[i];
  }

  Serial.print("MQTT [");
  Serial.print(topic);
  Serial.print("] => ");
  Serial.println(msg);

  // LED
  if(strcmp(topic, topic_led) == 0) {
    if(msg == "1")      digitalWrite(ledPin, HIGH);
    else if(msg == "0") digitalWrite(ledPin, LOW);
  }

  // TROCA DE ÁGUA
  if(strcmp(topic, topic_troca) == 0) {
    if(msg == "1") iniciarTrocaAgua();
  }

  // CONTROLE TÉRMICO
  if(strcmp(topic, topic_temperatura_set) == 0) {
    float novaTemp = msg.toFloat();
    if(novaTemp > 10.0 && novaTemp < 40.0) { 
      temperaturaDesejada = novaTemp;
      preferences.begin("controle_temp", false);
      preferences.putFloat("temp_ref", temperaturaDesejada);
      preferences.end();
      Serial.print("Nova temperatura alvo salva: ");
      Serial.println(temperaturaDesejada);
    }
  }

  // ALIMENTAÇÃO MANUAL (AGORA)
  if(strcmp(topic, topic_alimentacao_agora) == 0) {
    if(msg == "1") {
      realizarAlimentacao();
    }
  }

  // FREQUÊNCIA DE ALIMENTAÇÃO
  if(strcmp(topic, topic_alimentacao_freq) == 0) {
    int freq = msg.toInt();
    if(freq >= 0 && freq <= 3000) { 
      frequenciaAlimentacao = freq;
      preferences.begin("alimentacao", false);
      preferences.putInt("freq", frequenciaAlimentacao);
      preferences.end();
      Serial.print("Frequencia de alimentacao atualizada: ");
      Serial.print(frequenciaAlimentacao);
      Serial.println(" vezes ao dia.");
      
      // Reseta o timer para iniciar a contagem a partir de agora com a nova frequência
      ultimaAlimentacao = millis(); 
    }
  }
}

// ======================================================
// SETUP
// ======================================================
void setup() {
  Serial.begin(115200);

  // PINOS E RELÉS
  pinMode(ledPin, OUTPUT);
  pinMode(BOMBA_ENCHER, OUTPUT);
  pinMode(BOMBA_ESVAZIAR, OUTPUT);
  pinMode(TRIG_PIN, OUTPUT);
  pinMode(ECHO_PIN, INPUT);
  
  pinMode(TERMOSTATO, OUTPUT); 
  pinMode(VENTOINHA, OUTPUT);  

  digitalWrite(TRIG_PIN, LOW);
  desligarBombas();
  digitalWrite(TERMOSTATO, RELE_OFF);
  digitalWrite(VENTOINHA, RELE_OFF);

  // INICIA O SERVO
  servoAlimentador.attach(PINO_SERVO);
  servoAlimentador.write(90); // Garante a posição inicial de parada (Ponto Morto)
  
  // VELOCIDADE SOM
  float speed_Of_Sound = 331.1 + (0.606 * TEMP_C);
  distancia_Per_uSec = speed_Of_Sound / 10000.0;

  // DS18B20 INICIALIZAÇÃO
  sensorTemp.begin();
  sensorTemp.setWaitForConversion(false); 
  sensorTemp.requestTemperatures(); 

  // INA226
  Wire.begin(PIN_SDA, PIN_SCL);
  if(ina226.init()) {
    ina226.setAverage(INA226_AVERAGE_16);
    ina226.setConversionTime(INA226_CONV_TIME_1100);
  }

  // RECUPERANDO DADOS SALVOS DA FLASH
  preferences.begin("wifi-config", true);
  rede_local = preferences.getString("ssid", "");
  senha_local = preferences.getString("pass", "");
  preferences.end();

  preferences.begin("troca", true);
  tempoTrocaAprendido = preferences.getULong("tempo", 0);
  preferences.end();

  preferences.begin("controle_temp", true);
  temperaturaDesejada = preferences.getFloat("temp_ref", 25.0); 
  preferences.end();

  // RECUPERA A FREQUÊNCIA DE ALIMENTAÇÃO
  preferences.begin("alimentacao", true);
  frequenciaAlimentacao = preferences.getInt("freq", 1); // 1 vez ao dia se vazio
  preferences.end();
  Serial.print("Frequencia de alimentacao carregada: ");
  Serial.print(frequenciaAlimentacao);
  Serial.println(" vezes ao dia.");

  // Inicializa o tempo da ultima alimentacao com o momento do boot
  ultimaAlimentacao = millis();

  // WIFI E PORTAL AP
  WiFi.setAutoReconnect(true);
  WiFi.persistent(true);

  if(rede_local != "") {
    WiFi.begin(rede_local.c_str(), senha_local.c_str());
    int count = 0;
    while(WiFi.status() != WL_CONNECTED && count < 20) {
      delay(500);
      count++;
    }
  }

  if(WiFi.status() != WL_CONNECTED) {
    WiFi.softAP("GLUB_1_WIFI", "GLUB_1_WIFI");
    server.on("/", handleRoot);
    server.on("/save", HTTP_POST, handleSave);
    server.begin();

    while(WiFi.status() != WL_CONNECTED) {
      server.handleClient();
      digitalWrite(ledPin, (millis() / 500) % 2);
    }
    server.stop();
    WiFi.softAPdisconnect(true);
  }

  sincronizarHora();

  // MQTT
  espClient.setInsecure();
  client.setBufferSize(2048);
  client.setServer(mqtt_server, mqtt_port);
  client.setCallback(callback);

  Serial.println("Sistema iniciado.");
}

// ======================================================
// LOOP
// ======================================================
void loop() {
  manterConexoes();

  if(client.connected()) {
    client.loop();
  }

  atualizarUltrassom();
  tratarSensorINA226();
  tratarSensorTemperatura();
  atualizarControleTermico();
  atualizarTrocaAgua();
  
  // Executa rotina passiva do alimentador automático
  atualizarRotinaAlimentacao();

  publicarTelemetriaMQTT();
}

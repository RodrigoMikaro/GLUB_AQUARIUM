#include <WiFi.h>
#include <WiFiClientSecure.h>
#include <PubSubClient.h>
#include <WebServer.h>
#include <Preferences.h>
#include <Wire.h>
#include <INA226_WE.h>
#include "time.h"

// --- CONFIGURAÇÕES DO SENSOR INA226 ---
#define I2C_ADDRESS 0x40
INA226_WE ina226 = INA226_WE(I2C_ADDRESS);
const int PIN_SDA = 21; 
const int PIN_SCL = 22; 

// --- CONFIGURAÇÕES HIVEMQ ---
const char* mqtt_server = "0e6bf66e693b43c2a87b5cd707fe5647.s1.eu.hivemq.cloud";
const int mqtt_port    = 8883;
const char* mqtt_user   = "glub1"; 
const char* mqtt_pass   = "GlubAquarium1";
const char* topic_led      = "glub1/led";      // Para você ligar/desligar o LED
const char* topic_voltagem = "glub1/voltagem"; // Para você monitorar a tensão
const int ledPin           = 2;

// --- VARIÁVEIS GERAIS ---
WebServer server(80);
WiFiClientSecure espClient;
PubSubClient client(espClient);
Preferences preferences; 

String rede_local = "";
String senha_local = "";
float voltagem = 0.0;

unsigned long anteriorMillisMQTT = 0;
unsigned long anteriorMillisWiFi = 0;
unsigned long anteriorMillisPublicacao = 0;

// --- FUNÇÕES DE CONEXÃO E PORTAL (MANTIDAS) ---
void handleRoot() {
  String html = "<html><body style='text-align:center; font-family:sans-serif;'>";
  html += "<h2>Configurar Wi-Fi - GLUB</h2><form action='/save' method='POST'>";
  html += "Rede: <input type='text' name='ssid'><br><br>";
  html += "Senha: <input type='password' name='pass'><br><br>";
  html += "<input type='submit' value='Salvar'></form></body></html>";
  server.send(200, "text/html", html);
}

void handleSave() {
  preferences.begin("wifi-config", false);
  preferences.putString("ssid", server.arg("ssid"));
  preferences.putString("pass", server.arg("pass"));
  preferences.end();
  server.send(200, "text/html", "Configurações salvas! Reiniciando...");
  delay(2000);
  ESP.restart();
}

void sincronizarHora() {
  configTime(0, 0, "pool.ntp.org", "time.nist.gov");
  time_t now = time(nullptr);
  int tentativas = 0;
  while (now < 8 * 3600 * 2 && tentativas < 20) {
    delay(500);
    now = time(nullptr);
    tentativas++;
  }
}

void manterConexoes() {
  if (WiFi.status() != WL_CONNECTED) {
    if (millis() - anteriorMillisWiFi >= 10000) {
      WiFi.begin(rede_local.c_str(), senha_local.c_str());
      anteriorMillisWiFi = millis();
    }
    return;
  }

  if (!client.connected()) {
    if (millis() - anteriorMillisMQTT >= 10000) {
      String clientId = "ESP32_GLUB_" + String(random(0xffff), HEX);
      if (client.connect(clientId.c_str(), mqtt_user, mqtt_pass)) {
        client.subscribe(topic_led);
        Serial.println("MQTT Conectado!");
      }
      anteriorMillisMQTT = millis();
    }
  }
}

// --- NOVA LÓGICA: SENSOR APENAS ENVIA DADOS ---
void tratarSensor() {
  // Lê a voltagem independente da fonte (bateria ou tomada)
  voltagem = ina226.getBusVoltage_V();

  // Publica no MQTT a cada 1 segundo para monitoramento remoto
  if (millis() - anteriorMillisPublicacao >= 1000) {
    anteriorMillisPublicacao = millis();
    if (client.connected()) {
      char msgBuffer[10];
      dtostrf(voltagem, 4, 2, msgBuffer);
      client.publish(topic_voltagem, msgBuffer);
      Serial.printf("Voltagem enviada: %s V\n", msgBuffer);
    }
  }
}

void setup() {
  pinMode(ledPin, OUTPUT);
  Serial.begin(115200);

  // Inicializa o sensor
  Wire.begin(PIN_SDA, PIN_SCL);
  if (ina226.init()) {
    ina226.setAverage(INA226_AVERAGE_16);           
    ina226.setConversionTime(INA226_CONV_TIME_1100); 
    Serial.println("INA226 pronto.");
  }

  WiFi.setAutoReconnect(true);
  WiFi.persistent(true);

  preferences.begin("wifi-config", true);
  rede_local = preferences.getString("ssid", "");
  senha_local = preferences.getString("pass", "");
  preferences.end();

  if (rede_local != "") {
    WiFi.begin(rede_local.c_str(), senha_local.c_str());
    int count = 0;
    while (WiFi.status() != WL_CONNECTED && count < 20) { delay(500); count++; }
  }

  if (WiFi.status() != WL_CONNECTED) {
    WiFi.softAP("GLUB_1_WIFI", "GLUB_1_WIFI");
    server.on("/", handleRoot);
    server.on("/save", HTTP_POST, handleSave);
    server.begin();
    while (WiFi.status() != WL_CONNECTED) {
      server.handleClient();
      digitalWrite(ledPin, (millis() / 500) % 2 == 0); // Pisca lento no modo AP
    }
    server.stop();
    WiFi.softAPdisconnect(true);
  }

  sincronizarHora();
  espClient.setInsecure();
  client.setBufferSize(2048);
  client.setServer(mqtt_server, mqtt_port);
  
  // --- CALLBACK: LED OBEDECE APENAS AO MQTT ---
  client.setCallback([](char* topic, byte* payload, unsigned int length) {
    String msg;
    for (int i = 0; i < length; i++) msg += (char)payload[i];
    
    Serial.print("Comando LED recebido: ");
    Serial.println(msg);

    if (msg == "1") {
      digitalWrite(ledPin, HIGH); // Liga
    } 
    else if (msg == "0") {
      digitalWrite(ledPin, LOW);  // Desliga
    }
  });
}

void loop() {
  manterConexoes();
  tratarSensor(); // Lê e envia a voltagem a cada 1s
  if (client.connected()) {
    client.loop();
  }
}

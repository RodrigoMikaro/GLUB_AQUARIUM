#include <WiFi.h>
#include <WiFiClientSecure.h>
#include <PubSubClient.h>
#include <WebServer.h>
#include <Preferences.h>
#include <Wire.h>
#include <INA226_WE.h>
#include "time.h"

// ======================================================
// BIBLIOTECAS DE TEMPERATURA, PH E SERVO DO ESP32
// ======================================================
#include <OneWire.h>
#include <DallasTemperature.h>
#include <ESP32Servo.h> 

// ======================================================
// INA226
// ======================================================
#define I2C_ADDRESS 0x40
INA226_WE ina226 = INA226_WE(I2C_ADDRESS);
const int PIN_SDA = 21;
const int PIN_SCL = 22;

// ======================================================
// MQTT (Novos tópicos de pH, Temperatura e Servo inclusos)
// ======================================================
const char* mqtt_server = "0e6bf66e693b43c2a87b5cd707fe5647.s1.eu.hivemq.cloud";
const int mqtt_port = 8883;

const char* mqtt_user = "glub1";
const char* mqtt_pass = "GlubAquarium1";

const char* topic_led         = "glub1/led";
const char* topic_voltagem    = "glub1/voltagem";
const char* topic_troca       = "glub1/troca";
const char* topic_status      = "glub1/troca/status";
const char* topic_distancia   = "glub1/distancia";
const char* topic_ph          = "glub1/ph";
const char* topic_temperatura = "glub1/temperatura";
const char* topic_servo       = "glub1/servo";

// ======================================================
// PINOS
// ======================================================
const int ledPin = 2;
const int BOMBA_ENCHER   = 32;
const int BOMBA_ESVAZIAR = 33;
const int TRIG_PIN = 25;
const int ECHO_PIN = 26;

// Pinos dos Novos Sensores e Atuador
const int PIN_PH    = 27;
const int PIN_TEMP  = 16;
const int PIN_SERVO = 23;

// ======================================================
// CONFIGURAÇÕES DOS COMPONENTES (TEMP, SERVO, PH)
// ======================================================
OneWire oneWire(PIN_TEMP);
DallasTemperature sensors(&oneWire);
Servo meuServo;

float tensaoCalibrada = 2.68;
float fatorConversao = 3.5;
float OFFSET = 7.0 - (tensaoCalibrada * fatorConversao);

const float PH_MIN = 6.9;
const float PH_MAX = 7.2;

const int NUM_LEITURAS_PH = 100;
float leiturasPH[NUM_LEITURAS_PH];
int indiceMovel = 0;
float somaPH = 0.0;
bool vetorCheio = false;
float phMedio = 7.0;

float temperaturaAtual = 0.0;

// ======================================================
// CONTROLE DE TEMPO E TIMERS
// ======================================================
unsigned long tempoUltimaCorrecao = 0;
bool correcaoJaRealizada = false;
const unsigned long INTERVALO_ESPERA_SERVO = 60000UL; 

unsigned long anteriorMillisMQTT = 0;
unsigned long anteriorMillisWiFi = 0;
unsigned long anteriorMillisUltrassom = 0;
unsigned long anteriorMillisTelemetria = 0;

const unsigned long intervaloUltrassom = 100;
const unsigned long intervaloTelemetria = 1000;

const unsigned long TEMPO_MAX_DRENAGEM   = 180000;
const unsigned long TEMPO_MAX_ENCHIMENTO = 180000;

// ======================================================
// VARIÁVEIS DO SISTEMA
// ======================================================
WebServer server(80);
WiFiClientSecure espClient;
PubSubClient client(espClient);
Preferences preferences;

String rede_local = "";
String senha_local = "";
float voltagem = 0.0;
unsigned long tempoTrocaAprendido = 0;

enum EstadoTroca { IDLE, DRENANDO, ENCHENDO };
EstadoTroca estadoTroca = IDLE;
bool trocaAtiva = false;
unsigned long inicioEtapa = 0;

// ======================================================
// ULTRASSÔNICO
// ======================================================
const float TEMP_C = 20.0;
float distancia_Per_uSec;
const int NUM_LEITURAS = 10;
float leituras[NUM_LEITURAS];
float soma = 0;
int indice = 0;
int leiturasValidas = 0;
float distanciaCm = 0;
float distanciaMediaCm = 0;
const float DISTANCIA_MAX_RESERVATORIO_SUJO_CM = 28.0;

// ======================================================
// PORTAL WIFI E NTP
// ======================================================
void handleRoot() {
  String html;
  html += "<html><body style='text-align:center;font-family:sans-serif;'>";
  html += "<h2>Configurar WiFi - GLUB</h2>";
  html += "<form action='/save' method='POST'>";
  html += "Rede: <input type='text' name='ssid'><br><br>";
  html += "Senha: <input type='password' name='pass'><br><br>";
  html += "<input type='submit' value='Salvar'>";
  html += "</form></body></html>";
  server.send(200, "text/html", html);
}

void handleSave() {
  preferences.begin("wifi-config", false);
  preferences.putString("ssid", server.arg("ssid"));
  preferences.putString("pass", server.arg("pass"));
  preferences.end();
  server.send(200, "text/html", "Salvo! Reiniciando...");
  delay(2000);
  ESP.restart();
}

void sincronizarHora() {
  configTime(0, 0, "pool.ntp.org", "time.nist.gov");
  time_t now = time(nullptr);
  int tentativas = 0;
  while(now < 8 * 3600 * 2 && tentativas < 20) {
    delay(500);
    now = time(nullptr);
    tentativas++;
  }
}

// ======================================================
// BOMBAS E RELES
// ======================================================
const int RELE_ON  = HIGH;
const int RELE_OFF = LOW;

void desligarBombas() {
  digitalWrite(BOMBA_ENCHER, RELE_OFF);
  digitalWrite(BOMBA_ESVAZIAR, RELE_OFF);
}
void ligarBombaEncher() {
  digitalWrite(BOMBA_ESVAZIAR, RELE_OFF);
  digitalWrite(BOMBA_ENCHER, RELE_ON);
}
void ligarBombaEsvaziar() {
  digitalWrite(BOMBA_ENCHER, RELE_OFF);
  digitalWrite(BOMBA_ESVAZIAR, RELE_ON);
}

void publicarStatus(const char* msg) {
  if(client.connected()) {
    client.publish(topic_status, msg, true);
  }
}

// ======================================================
// LEITURA DOS SENSORES (pH e Temperatura)
// ======================================================
void lerSensoresAgua() {
  // Temperatura
  sensors.requestTemperatures();
  temperaturaAtual = sensors.getTempCByIndex(0);

  // pH com correção para Divisor de Tensão de Resistor (1k e paralelo de 1k)
  int leituraADC = analogRead(PIN_PH);
  float tensaoESP = (leituraADC * 3.3) / 4095.0; 
  float tensaoOriginal = tensaoESP * 3.0; // Fator multiplicador corrigido para o seu circuito físico
  
  float phInstantaneo = (tensaoOriginal * fatorConversao) + OFFSET;

  // Média móvel do pH
  somaPH -= leiturasPH[indiceMovel];
  leiturasPH[indiceMovel] = phInstantaneo;
  somaPH += leiturasPH[indiceMovel];
  indiceMovel++;

  if (indiceMovel >= NUM_LEITURAS_PH) {
      indiceMovel = 0;
      vetorCheio = true;
  }

  if (vetorCheio) {
      phMedio = somaPH / NUM_LEITURAS_PH;
  } else {
      phMedio = somaPH / (indiceMovel == 0 ? 1 : indiceMovel);
  }
}

// ======================================================
// CONTROLE DO SERVO DO PH E NOTIFICAÇÃO MQTT
// ======================================================
void controlarServoPH() {
  bool phCritico = (phMedio < PH_MIN || phMedio > PH_MAX);

  if (phCritico) {
      unsigned long agora = millis();
      bool podeCorrigir = !correcaoJaRealizada || (agora - tempoUltimaCorrecao >= INTERVALO_ESPERA_SERVO);

      if (podeCorrigir) {
          Serial.println("\n[ALERTA] pH fora da faixa! Acionando servo...");
          
          // Envia o status para o MQTT informando que o servo foi ativado (1)
          if(client.connected()) {
              client.publish(topic_servo, "1", true);
          }

          meuServo.write(180);
          delay(1000);
          meuServo.write(90);
          delay(1000);
          meuServo.write(180);
          delay(1000);
          meuServo.write(90);
          delay(1000);

          // Envia o status para o MQTT informando que a correção acabou (0)
          if(client.connected()) {
              client.publish(topic_servo, "0", true);
          }

          tempoUltimaCorrecao = millis(); 
          correcaoJaRealizada = true;
          Serial.println("[SISTEMA] Correcao realizada.");
      }
  }
}

// ======================================================
// ULTRASSÔNICO
// ======================================================
void atualizarUltrassom() {
  if(millis() - anteriorMillisUltrassom < intervaloUltrassom) return;
  anteriorMillisUltrassom = millis();

  digitalWrite(TRIG_PIN, LOW);
  delayMicroseconds(2);
  digitalWrite(TRIG_PIN, HIGH);
  delayMicroseconds(15);
  digitalWrite(TRIG_PIN, LOW);

  long duration = pulseIn(ECHO_PIN, HIGH, 15000);

  if(duration > 0 && duration < 25000) {
    distanciaCm = (duration / 2.0) * distancia_Per_uSec;
    if(leiturasValidas < NUM_LEITURAS) {
      leituras[indice] = distanciaCm;
      soma += distanciaCm;
      leiturasValidas++;
    } else {
      soma -= leituras[indice];
      leituras[indice] = distanciaCm;
      soma += distanciaCm;
    }
    indice = (indice + 1) % NUM_LEITURAS;
    distanciaMediaCm = soma / leiturasValidas;
  }
}

void tratarSensorINA226() {
  voltagem = ina226.getBusVoltage_V();
}

// ======================================================
// TELEMETRIA COMPLETA VIA MQTT
// ======================================================
void publicarTelemetriaMQTT() {
  if(millis() - anteriorMillisTelemetria < intervaloTelemetria) return;
  anteriorMillisTelemetria = millis();

  // Impressões de monitoramento no Serial Monitor
  Serial.print("pH Medio: ");
  Serial.print(phMedio, 2);
  Serial.print(" | Temp: ");
  Serial.print(temperaturaAtual, 1);
  Serial.print(" C | ");

  if (correcaoJaRealizada) {
      unsigned long tempoDecorrido = millis() - tempoUltimaCorrecao;
      if (tempoDecorrido < INTERVALO_ESPERA_SERVO) {
          unsigned long segundosRestantes = (INTERVALO_ESPERA_SERVO - tempoDecorrido) / 1000;
          Serial.print("Servo travado por: ");
          Serial.print(segundosRestantes);
          Serial.print("s | ");
      }
  }

  if(!client.connected()) {
    Serial.println("MQTT Desconectado.");
    return;
  }

  // 1. Envia Voltagem
  char bufferVolt[10];
  dtostrf(voltagem, 4, 2, bufferVolt);
  client.publish(topic_voltagem, bufferVolt, true);

  // 2. Envia Distância
  char bufferDist[10];
  dtostrf(distanciaMediaCm, 4, 1, bufferDist);
  client.publish(topic_distancia, bufferDist, true);

  // 3. Envia pH Médio Atualizado
  char bufferPH[10];
  dtostrf(phMedio, 4, 2, bufferPH);
  client.publish(topic_ph, bufferPH, true);

  // 4. Envia Temperatura Atualizada
  char bufferTemp[10];
  dtostrf(temperaturaAtual, 4, 1, bufferTemp);
  client.publish(topic_temperatura, bufferTemp, true);

  Serial.print("MQTT -> Volt: ");
  Serial.print(bufferVolt);
  Serial.print(" | Dist: ");
  Serial.print(bufferDist);
  Serial.print(" | pH: ");
  Serial.print(bufferPH);
  Serial.print(" | Temp: ");
  Serial.println(bufferTemp);
}

// ======================================================
// ROTINA DE TROCA AUTOMÁTICA DE ÁGUA
// ======================================================
void iniciarTrocaAgua() {
  if(trocaAtiva) return;
  trocaAtiva = true;
  estadoTroca = DRENANDO;
  inicioEtapa = millis();
  ligarBombaEsvaziar();
  publicarStatus("drenando");
  Serial.println("Iniciando drenagem...");
}

void finalizarTroca() {
  desligarBombas();
  estadoTroca = IDLE;
  trocaAtiva = false;
  publicarStatus("concluido");
  Serial.println("Troca concluida.");
}

void atualizarTrocaAgua() {
  if(!trocaAtiva) return;
  unsigned long agora = millis();

  if(estadoTroca == DRENANDO) {
    bool atingiuNivel = (distanciaMediaCm >= 24.0 && distanciaMediaCm <= 28.0);
    bool timeout = (agora - inicioEtapa >= TEMPO_MAX_DRENAGEM);

    if(atingiuNivel || timeout) {
      unsigned long tempoDrenagem = agora - inicioEtapa;
      if(atingiuNivel) {
        tempoTrocaAprendido = tempoDrenagem;
        preferences.begin("troca", false);
        preferences.putULong("tempo", tempoTrocaAprendido);
        preferences.end();
      }
      desligarBombas();
      ligarBombaEncher();
      estadoTroca = ENCHENDO;
      inicioEtapa = millis();
      publicarStatus("enchendo");
    }
  }
  else if(estadoTroca == ENCHENDO) {
    unsigned long tempoUsado = (tempoTrocaAprendido > 0) ? tempoTrocaAprendido : 30000;
    bool terminou = (agora - inicioEtapa >= tempoUsado);
    bool timeout = (agora - inicioEtapa >= TEMPO_MAX_ENCHIMENTO);
    if(terminou || timeout) finalizarTroca();
  }
}

// ======================================================
// GERE GERENCIAMENTO DE CONEXÕES (Wi-Fi e MQTT)
// ======================================================
void manterConexoes() {
  if(WiFi.status() != WL_CONNECTED) {
    if(millis() - anteriorMillisWiFi >= 10000) { 
      WiFi.begin(rede_local.c_str(), senha_local.c_str());
      anteriorMillisWiFi = millis(); 
    }
    return;
  }

  if(!client.connected()) {
    if(millis() - anteriorMillisMQTT >= 10000) {
      String clientId = "ESP32_GLUB_" + String(random(0xffff), HEX);
      if(client.connect(clientId.c_str(), mqtt_user, mqtt_pass)) {
        client.subscribe(topic_led);
        client.subscribe(topic_troca);
        Serial.println("MQTT Conectado!");
      }
      anteriorMillisMQTT = millis();
    }
  }
}

void callback(char* topic, byte* payload, unsigned int length) {
  String msg;
  for(int i = 0; i < length; i++) {
    msg += (char)payload[i];
  }

  if(strcmp(topic, topic_led) == 0) {
    if(msg == "1") digitalWrite(ledPin, HIGH);
    else if(msg == "0") digitalWrite(ledPin, LOW);
  }
  if(strcmp(topic, topic_troca) == 0) {
    if(msg == "1") iniciarTrocaAgua();
  }
}

// ======================================================
// SETUP
// ======================================================
void setup() {
  Serial.begin(115200);

  pinMode(ledPin, OUTPUT);
  pinMode(BOMBA_ENCHER, OUTPUT);
  pinMode(BOMBA_ESVAZIAR, OUTPUT);
  pinMode(TRIG_PIN, OUTPUT);
  pinMode(ECHO_PIN, INPUT);
  digitalWrite(TRIG_PIN, LOW);
  desligarBombas();
  
  // Resolução nativa de 12 bits do ESP32 para o pino analógico do pH
  analogReadResolution(12);

  sensors.begin();
  
  // Alocação de timer necessária para o Servo operar corretamente no ESP32
  ESP32PWM::allocateTimer(0);
  meuServo.setPeriodHertz(50);
  meuServo.attach(PIN_SERVO, 500, 2400); 
  meuServo.write(90);

  for (int i = 0; i < NUM_LEITURAS_PH; i++) {
      leiturasPH[i] = 0;
  }

  float speed_Of_Sound = 331.1 + (0.606 * TEMP_C);
  distancia_Per_uSec = speed_Of_Sound / 10000.0;
  for(int i = 0; i < NUM_LEITURAS; i++) leituras[i] = 0;

  Wire.begin(PIN_SDA, PIN_SCL);
  if(ina226.init()) {
    ina226.setAverage(INA226_AVERAGE_16);
    ina226.setConversionTime(INA226_CONV_TIME_1100);
  }

  preferences.begin("wifi-config", true);
  rede_local = preferences.getString("ssid", "");
  senha_local = preferences.getString("pass", "");
  preferences.end();

  preferences.begin("troca", true);
  tempoTrocaAprendido = preferences.getULong("tempo", 0);
  preferences.end();

  WiFi.setAutoReconnect(true);
  WiFi.persistent(true);
  if(rede_local != "") {
    WiFi.begin(rede_local.c_str(), senha_local.c_str());
    int count = 0;
    while(WiFi.status() != WL_CONNECTED && count < 20) {
      delay(500);
      count++;
    }
  }

  if(WiFi.status() != WL_CONNECTED) {
    WiFi.softAP("GLUB_1_WIFI", "GLUB_1_WIFI");
    server.on("/", handleRoot);
    server.on("/save", HTTP_POST, handleSave);
    server.begin();
    while(WiFi.status() != WL_CONNECTED) {
      server.handleClient();
      digitalWrite(ledPin, (millis() / 500) % 2);
    }
    server.stop();
    WiFi.softAPdisconnect(true);
  }

  sincronizarHora();

  espClient.setInsecure();
  client.setBufferSize(2048);
  client.setServer(mqtt_server, mqtt_port);
  client.setCallback(callback);
}

// ======================================================
// LOOP PRINCIPAL
// ======================================================
void loop() {
  manterConexoes();

  if(client.connected()) {
    client.loop();
  }

  atualizarUltrassom();
  tratarSensorINA226();
  atualizarTrocaAgua();
  
  lerSensoresAgua();
  controlarServoPH();

  publicarTelemetriaMQTT();
}

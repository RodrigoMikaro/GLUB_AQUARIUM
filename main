#include <WiFi.h>
#include <WiFiClientSecure.h>
#include <PubSubClient.h>
#include <WebServer.h>
#include <Preferences.h>
#include "time.h"

// --- CONFIGURAÇÕES HIVEMQ ---
const char* mqtt_server = "0e6bf66e693b43c2a87b5cd707fe5647.s1.eu.hivemq.cloud";
const int mqtt_port    = 8883;
const char* mqtt_user   = "glub1"; 
const char* mqtt_pass   = "GlubAquarium1";
const char* topic_led   = "glub1/led";
const int ledPin        = 2;

// --- CONFIGURAÇÕES PORTAL CAPTIVO ---
const char* ssid_ap = "GLUB_1_WIFI";
const char* pass_ap = "GLUB_1_WIFI";

WebServer server(80);
WiFiClientSecure espClient;
PubSubClient client(espClient);
Preferences preferences; 

String rede_local = "";
String senha_local = "";
unsigned long anteriorMillisMQTT = 0;
unsigned long anteriorMillisWiFi = 0;

// --- FUNÇÕES DO PORTAL DE CONFIGURAÇÃO ---
void handleRoot() {
  String html = "<html><body style='text-align:center; font-family:sans-serif;'>";
  html += "<h2>Configurar Wi-Fi - GLUB</h2><form action='/save' method='POST'>";
  html += "Rede: <input type='text' name='ssid'><br><br>";
  html += "Senha: <input type='password' name='pass'><br><br>";
  html += "<input type='submit' value='Salvar'></form></body></html>";
  server.send(200, "text/html", html);
}

void handleSave() {
  preferences.begin("wifi-config", false);
  preferences.putString("ssid", server.arg("ssid"));
  preferences.putString("pass", server.arg("pass"));
  preferences.end();
  server.send(200, "text/html", "Configuracoes salvas! O dispositivo ira reiniciar...");
  delay(2000);
  ESP.restart();
}

// --- SINCRONIZAÇÃO DE HORA (OBRIGATÓRIO PARA SSL/TLS) ---
void sincronizarHora() {
  configTime(0, 0, "pool.ntp.org", "time.nist.gov");
  Serial.print("Sincronizando hora para TLS...");
  time_t now = time(nullptr);
  int tentativas = 0;
  while (now < 8 * 3600 * 2 && tentativas < 20) {
    delay(500);
    Serial.print(".");
    now = time(nullptr);
    tentativas++;
  }
  Serial.println("\nHora sincronizada!");
}

// --- GESTÃO DE CONEXÕES (WI-FI E MQTT) ---
void manterConexoes() {
  // 1. Verifica Wi-Fi
  if (WiFi.status() != WL_CONNECTED) {
    if (millis() - anteriorMillisWiFi >= 10000) {
      Serial.println("Wi-Fi offline. Tentando reconectar...");
      WiFi.begin(rede_local.c_str(), senha_local.c_str());
      anteriorMillisWiFi = millis();
    }
    return; // Se não tem Wi-Fi, não tenta MQTT
  }

  // 2. Verifica MQTT
  if (!client.connected()) {
    if (millis() - anteriorMillisMQTT >= 10000) {
      Serial.print("Tentando conectar ao HiveMQ...");
      
      // Criar um ID de cliente único
      String clientId = "ESP32_GLUB_" + String(random(0xffff), HEX);
      
      if (client.connect(clientId.c_str(), mqtt_user, mqtt_pass)) {
        Serial.println(" CONECTADO!");
        client.subscribe(topic_led);
      } else {
        Serial.printf(" FALHA rc=%d\n", client.state());
      }
      anteriorMillisMQTT = millis();
    }
  }
}

void setup() {
  pinMode(ledPin, OUTPUT);
  Serial.begin(115200);

  // Configurações de persistência do Wi-Fi
  WiFi.setAutoReconnect(true);
  WiFi.persistent(true);

  // Recupera credenciais da memória flash
  preferences.begin("wifi-config", true);
  rede_local = preferences.getString("ssid", "");
  senha_local = preferences.getString("pass", "");
  preferences.end();

  // Tenta conectar ao Wi-Fi salvo
  if (rede_local != "") {
    Serial.println("Conectando ao Wi-Fi: " + rede_local);
    WiFi.begin(rede_local.c_str(), senha_local.c_str());
    int count = 0;
    while (WiFi.status() != WL_CONNECTED && count < 20) {
      delay(500);
      Serial.print(".");
      count++;
    }
  }

  // Se não conectou, abre o Portal de Configuração
  if (WiFi.status() != WL_CONNECTED) {
    Serial.println("\nWi-Fi nao encontrado. Iniciando Access Point...");
    WiFi.softAP(ssid_ap, pass_ap);
    server.on("/", handleRoot);
    server.on("/save", HTTP_POST, handleSave);
    server.begin();
    
    while (WiFi.status() != WL_CONNECTED) {
      server.handleClient();
      // LED pisca rápido indicando modo configuração
      digitalWrite(ledPin, (millis() / 200) % 2 == 0);
    }
    server.stop();
    WiFi.softAPdisconnect(true);
  }

  Serial.println("\nWi-Fi Conectado com sucesso!");

  // Configurações de Segurança para HiveMQ Cloud
  sincronizarHora();
  espClient.setInsecure(); // Permite conexão sem validar o certificado raiz (ideal para ESP32)
  
  client.setBufferSize(2048); // Buffer maior para pacotes TLS
  client.setServer(mqtt_server, mqtt_port);
  
  // Callback para receber mensagens
  client.setCallback([](char* topic, byte* payload, unsigned int length) {
    Serial.print("Mensagem recebida [");
    Serial.print(topic);
    Serial.print("]: ");
    
    String msg;
    for (int i = 0; i < length; i++) msg += (char)payload[i];
    Serial.println(msg);

    if (msg == "1") digitalWrite(ledPin, HIGH);
    else if (msg == "0") digitalWrite(ledPin, LOW);
  });
}

void loop() {
  manterConexoes();
  
  if (client.connected()) {
    client.loop();
  }
}

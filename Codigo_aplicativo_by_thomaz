  DateTime? ultimaTrocaAgua;

  // NOVO: temperatura ideal configurável pelo usuário
  double? tempIdeal;
  final TextEditingController _ctrlTempIdeal = TextEditingController();

  double temperaturaAtual = 0;
  double temperaturaInstantanea = 0;
  DateTime? ultimaAtualizacaoTemp;

  double voltagemInstantanea = 0;
  DateTime? ultimaAtualizacaoVolt;

  double phInstantaneo = 0;
  DateTime? ultimaAtualizacaoPh;
  final List<LeituraPh> _historicoPh = [];
  DateTime? _ultimaLeituraHistoricoPh;

  bool esp32Conectado = false;
  DateTime? ultimaMensagemEsp32;

  final List<LeituraTemp> _historicoTemp = [];
  DateTime? _ultimaLeituraHistorico;

  final List<LeituraDiaria> _historicoSemanal = [];
  final List<double> _bufferManha = [];
  final List<double> _bufferTarde = [];
  final List<double> _bufferNoite = [];
  String _diaAtualBuffers = '';

  // NOVO: histórico semanal de pH
  final List<LeituraDiariaPh> _historicoSemanalPh = [];
  final List<double> _bufferPhManha = [];
  final List<double> _bufferPhTarde = [];
  final List<double> _bufferPhNoite = [];
  String _diaAtualBuffersPh = '';

  int diasParaTroca = 7;
  DateTime proximaTroca = DateTime.now().add(const Duration(days: 7));

  DateTime _focusedDay = DateTime.now();
  DateTime diaSelecionado = DateTime.now();

  Map<DateTime, List<TarefaCalendario>> tarefas = {
    DateTime.utc(2026, 5, 31): [
      TarefaCalendario(nome: "Troca de água"),
      TarefaCalendario(nome: "Limpeza do filtro"),
    ],
  };

  // ======================================================
  // HELPERS DE TEMPERATURA IDEAL
  // ======================================================

  double get _tempMin => tempIdeal != null ? tempIdeal! - 2.5 : 24.0;
  double get _tempMax => tempIdeal != null ? tempIdeal! + 2.5 : 28.0;

  String get _subtituloTempIdeal =>
      "Ideal: ${_tempMin.toStringAsFixed(1)} °C – ${_tempMax.toStringAsFixed(1)} °C";

  Color _corTemperatura(double temp) {
    if (temp == 0) return const Color(0xFF00D1FF);
    if (temp < _tempMin) return Colors.blueAccent;
    if (temp > _tempMax) return Colors.deepOrangeAccent;
    return const Color(0xFF00D1FF);
  }

  // ======================================================
  // INIT STATE
  // ======================================================

  @override
  void initState() {
    super.initState();

    _atualizarDatasDeNocalendario(7);
    _carregarDadosIniciais();

    mqtt.onTemperatura = (temp) {
      final agora = DateTime.now();
      setState(() {
        temperaturaInstantanea = temp;
        ultimaAtualizacaoTemp = agora;
        temperaturaAtual = temp;

        if (_ultimaLeituraHistorico == null ||
            agora.difference(_ultimaLeituraHistorico!).inMinutes >= 20) {
          _historicoTemp.add(LeituraTemp(valor: temp, horario: agora));
          _ultimaLeituraHistorico = agora;
          if (_historicoTemp.length > 36) _historicoTemp.removeAt(0);
          _salvarLeituraHistorico(temp, agora);
        }

        final chaveHoje = _chaveData(agora);
        if (_diaAtualBuffers.isNotEmpty && _diaAtualBuffers != chaveHoje) {
          _bufferManha.clear();
          _bufferTarde.clear();
          _bufferNoite.clear();
        }
        _diaAtualBuffers = chaveHoje;

        final hora = agora.hour;
        final String periodo;
        if (hora < 8) {
          _bufferManha.add(temp);
          periodo = 'manha';
        } else if (hora < 16) {
          _bufferTarde.add(temp);
          periodo = 'tarde';
        } else {
          _bufferNoite.add(temp);
          periodo = 'noite';
        }

        final ts = agora.millisecondsSinceEpoch.toString();
        _dbRef
            .child('glub1/leituras_brutas/$chaveHoje/$periodo/$ts')
            .set(temp);

        _atualizarHistoricoSemanal(agora);
      });
    };

    mqtt.onVoltagem = (volts) {
      setState(() {
        voltagemInstantanea = volts;
        ultimaAtualizacaoVolt = DateTime.now();
      });
    };

    mqtt.onPh = (ph) {
      final agora = DateTime.now();
      setState(() {
        phInstantaneo = ph;
        ultimaAtualizacaoPh = agora;

        if (_ultimaLeituraHistoricoPh == null ||
            agora.difference(_ultimaLeituraHistoricoPh!).inMinutes >= 20) {
          _historicoPh.add(LeituraPh(valor: ph, horario: agora));
          _ultimaLeituraHistoricoPh = agora;
          if (_historicoPh.length > 36) _historicoPh.removeAt(0);
          _salvarLeituraHistoricoPh(ph, agora);
        }

        // NOVO: buffers semanais de pH
        final chaveHoje = _chaveData(agora);
        if (_diaAtualBuffersPh.isNotEmpty && _diaAtualBuffersPh != chaveHoje) {
          _bufferPhManha.clear();
          _bufferPhTarde.clear();
          _bufferPhNoite.clear();
        }
        _diaAtualBuffersPh = chaveHoje;

        final hora = agora.hour;
        final String periodo;
        if (hora < 8) {
          _bufferPhManha.add(ph);
          periodo = 'manha';
        } else if (hora < 16) {
          _bufferPhTarde.add(ph);
          periodo = 'tarde';
        } else {
          _bufferPhNoite.add(ph);
          periodo = 'noite';
        }

        final ts = agora.millisecondsSinceEpoch.toString();
        _dbRef
            .child('glub1/leituras_brutas_ph/$chaveHoje/$periodo/$ts')
            .set(ph);

        _atualizarHistoricoSemanalPh(agora);
      });
    };

    mqtt.onEsp32Status = (conectado) {
      setState(() {
        esp32Conectado = conectado;
        ultimaMensagemEsp32 = DateTime.now();
      });
      Future.delayed(const Duration(seconds: 60), () {
        if (mounted) {
          final agora = DateTime.now();
          if (ultimaMensagemEsp32 != null &&
              agora.difference(ultimaMensagemEsp32!).inSeconds >= 60) {
            setState(() => esp32Conectado = false);
          }
        }
      });
    };

    mqtt.connect();
  }

  // ======================================================
  // HELPER: chave de data
  // ======================================================

  String _chaveData(DateTime dt) =>
      '${dt.year}-${dt.month.toString().padLeft(2, '0')}-${dt.day.toString().padLeft(2, '0')}';

  // ======================================================
  // CARREGA DADOS INICIAIS DO FIREBASE
  // ======================================================

  Future<void> _carregarDadosIniciais() async {
    try {
      final snapTemp = await _dbRef.child('glub1/temperatura_atual').get();
      final snapVolt = await _dbRef.child('glub1/voltagem_atual').get();
      final snapPh = await _dbRef.child('glub1/ph_atual').get();

      if (snapTemp.exists && snapTemp.value != null) {
        final temp = (snapTemp.value as num).toDouble();
        setState(() {
          temperaturaAtual = temp;
          temperaturaInstantanea = temp;
        });
      }

      if (snapVolt.exists && snapVolt.value != null) {
        final volt = (snapVolt.value as num).toDouble();
        setState(() => voltagemInstantanea = volt);
      }

      if (snapPh.exists && snapPh.value != null) {
        final ph = (snapPh.value as num).toDouble();
        setState(() => phInstantaneo = ph);
      }

      // Histórico intraday de temperatura
      final snapHistorico = await _dbRef
          .child('glub1/historico_temp')
          .orderByKey()
          .limitToLast(36)
          .get();

      if (snapHistorico.exists && snapHistorico.value != null) {
        final Map<dynamic, dynamic> dados =
            snapHistorico.value as Map<dynamic, dynamic>;
        final leituras = dados.entries.map((e) {
          final ts = int.tryParse(e.key.toString()) ?? 0;
          final valor = (e.value as num).toDouble();
          return LeituraTemp(
            valor: valor,
            horario: DateTime.fromMillisecondsSinceEpoch(ts),
          );
        }).toList();
        leituras.sort((a, b) => a.horario.compareTo(b.horario));
        setState(() {
          _historicoTemp.clear();
          _historicoTemp.addAll(leituras);
          if (_historicoTemp.isNotEmpty) {
            _ultimaLeituraHistorico = _historicoTemp.last.horario;
          }
        });
      }

      // Histórico intraday de pH
      final snapHistoricoPh = await _dbRef
          .child('glub1/historico_ph')
          .orderByKey()
          .limitToLast(36)
          .get();

      if (snapHistoricoPh.exists && snapHistoricoPh.value != null) {
        final Map<dynamic, dynamic> dados =
            snapHistoricoPh.value as Map<dynamic, dynamic>;
        final leituras = dados.entries.map((e) {
          final ts = int.tryParse(e.key.toString()) ?? 0;
          final valor = (e.value as num).toDouble();
          return LeituraPh(
            valor: valor,
            horario: DateTime.fromMillisecondsSinceEpoch(ts),
          );
        }).toList();
        leituras.sort((a, b) => a.horario.compareTo(b.horario));
        setState(() {
          _historicoPh.clear();
          _historicoPh.addAll(leituras);
          if (_historicoPh.isNotEmpty) {
            _ultimaLeituraHistoricoPh = _historicoPh.last.horario;
          }
        });
      }

      // Histórico semanal de temperatura
      final snapSemanal = await _dbRef
          .child('glub1/historico_semanal')
          .orderByKey()
          .limitToLast(7)
          .get();

      if (snapSemanal.exists && snapSemanal.value != null) {
        final Map<dynamic, dynamic> dados =
            snapSemanal.value as Map<dynamic, dynamic>;
        final List<LeituraDiaria> leiturasSemana = [];
        for (final entry in dados.entries) {
          final partes = entry.key.toString().split('-');
          if (partes.length != 3) continue;
          final dia = DateTime.utc(
            int.parse(partes[0]),
            int.parse(partes[1]),
            int.parse(partes[2]),
          );
          final periodos = entry.value as Map<dynamic, dynamic>;
          leiturasSemana.add(LeituraDiaria(
            dia: dia,
            mediaManha: (periodos['manha'] as num?)?.toDouble() ?? 0,
            mediaTarde: (periodos['tarde'] as num?)?.toDouble() ?? 0,
            mediaNoite: (periodos['noite'] as num?)?.toDouble() ?? 0,
          ));
        }
        leiturasSemana.sort((a, b) => a.dia.compareTo(b.dia));
        setState(() {
          _historicoSemanal.clear();
          _historicoSemanal.addAll(leiturasSemana);
        });
      }

      // NOVO: histórico semanal de pH
      final snapSemanalPh = await _dbRef
          .child('glub1/historico_semanal_ph')
          .orderByKey()
          .limitToLast(7)
          .get();

      if (snapSemanalPh.exists && snapSemanalPh.value != null) {
        final Map<dynamic, dynamic> dados =
            snapSemanalPh.value as Map<dynamic, dynamic>;
        final List<LeituraDiariaPh> leiturasSemana = [];
        for (final entry in dados.entries) {
          final partes = entry.key.toString().split('-');
          if (partes.length != 3) continue;
          final dia = DateTime.utc(
            int.parse(partes[0]),
            int.parse(partes[1]),
            int.parse(partes[2]),
          );
          final periodos = entry.value as Map<dynamic, dynamic>;
          leiturasSemana.add(LeituraDiariaPh(
            dia: dia,
            mediaManha: (periodos['manha'] as num?)?.toDouble() ?? 0,
            mediaTarde: (periodos['tarde'] as num?)?.toDouble() ?? 0,
            mediaNoite: (periodos['noite'] as num?)?.toDouble() ?? 0,
          ));
        }
        leiturasSemana.sort((a, b) => a.dia.compareTo(b.dia));
        setState(() {
          _historicoSemanalPh.clear();
          _historicoSemanalPh.addAll(leiturasSemana);
        });
      }

      // Restaurar buffers de temperatura do dia atual
      final hoje = DateTime.now();
      final chaveHoje = _chaveData(hoje);

      final snapBrutos = await _dbRef
          .child('glub1/leituras_brutas/$chaveHoje')
          .get();

      if (snapBrutos.exists && snapBrutos.value != null) {
        final periodos = snapBrutos.value as Map<dynamic, dynamic>;
        void carregarPeriodo(String periodo, List<double> buffer) {
          if (periodos[periodo] == null) return;
          final leituras = periodos[periodo] as Map<dynamic, dynamic>;
          for (final v in leituras.values) {
            buffer.add((v as num).toDouble());
          }
        }
        setState(() {
          _diaAtualBuffers = chaveHoje;
          carregarPeriodo('manha', _bufferManha);
          carregarPeriodo('tarde', _bufferTarde);
          carregarPeriodo('noite', _bufferNoite);
        });
        _atualizarHistoricoSemanal(hoje);
      }

      // NOVO: restaurar buffers de pH do dia atual
      final snapBrutosPh = await _dbRef
          .child('glub1/leituras_brutas_ph/$chaveHoje')
          .get();

      if (snapBrutosPh.exists && snapBrutosPh.value != null) {
        final periodos = snapBrutosPh.value as Map<dynamic, dynamic>;
        void carregarPeriodo(String periodo, List<double> buffer) {
          if (periodos[periodo] == null) return;
          final leituras = periodos[periodo] as Map<dynamic, dynamic>;
          for (final v in leituras.values) {
            buffer.add((v as num).toDouble());
          }
        }
        setState(() {
          _diaAtualBuffersPh = chaveHoje;
          carregarPeriodo('manha', _bufferPhManha);
          carregarPeriodo('tarde', _bufferPhTarde);
          carregarPeriodo('noite', _bufferPhNoite);
        });
        _atualizarHistoricoSemanalPh(hoje);
      }

      // Limpar leituras brutas de temp antigas (>7 dias)
      final corte = hoje.subtract(const Duration(days: 7));
      final chaveCorte = _chaveData(corte);
      final snapBrutosAntigos = await _dbRef
          .child('glub1/leituras_brutas')
          .orderByKey()
          .endBefore(chaveCorte)
          .get();
      if (snapBrutosAntigos.exists && snapBrutosAntigos.value != null) {
        final antigos = snapBrutosAntigos.value as Map<dynamic, dynamic>;
        for (final chave in antigos.keys) {
          _dbRef.child('glub1/leituras_brutas/$chave').remove();
        }
      }

      // NOVO: limpar leituras brutas de pH antigas (>7 dias)
      final snapBrutosPhAntigos = await _dbRef
          .child('glub1/leituras_brutas_ph')
          .orderByKey()
          .endBefore(chaveCorte)
          .get();
      if (snapBrutosPhAntigos.exists && snapBrutosPhAntigos.value != null) {
        final antigos = snapBrutosPhAntigos.value as Map<dynamic, dynamic>;
        for (final chave in antigos.keys) {
          _dbRef.child('glub1/leituras_brutas_ph/$chave').remove();
        }
      }

      final snapAlim =
          await _dbRef.child('glub1/acionamentos/alimentacao').get();
      if (snapAlim.exists && snapAlim.value != null) {
        final ts = (snapAlim.value as num).toInt();
        setState(() =>
            ultimaAlimentacao = DateTime.fromMillisecondsSinceEpoch(ts));
      }

      final snapTroca =
          await _dbRef.child('glub1/acionamentos/troca_agua').get();
      if (snapTroca.exists && snapTroca.value != null) {
        final ts = (snapTroca.value as num).toInt();
        setState(
            () => ultimaTrocaAgua = DateTime.fromMillisecondsSinceEpoch(ts));
      }

      // Carregar configs salvas
      final snapLed = await _dbRef.child('glub1/config/intensidade_led').get();
      if (snapLed.exists && snapLed.value != null) {
        final v = (snapLed.value as num).toInt();
        setState(() {
          intensidadeLed = v;
          _ctrlLed.text = '$v';
        });
      }

      final snapAlimFreq =
          await _dbRef.child('glub1/config/frequencia_alimentacao').get();
      if (snapAlimFreq.exists && snapAlimFreq.value != null) {
        final v = (snapAlimFreq.value as num).toInt();
        setState(() {
          frequenciaAlimentacao = v;
          _ctrlAlimentacao.text = '$v';
        });
      }
      final snapTrocaMes =
          await _dbRef.child('glub1/config/frequencia_troca_mes').get();
      if (snapTrocaMes.exists && snapTrocaMes.value != null) {
        final v = (snapTrocaMes.value as num).toInt();
        setState(() {
          frequenciaTrocaMes = v;
          _ctrlTrocaMes.text = '$v';
          if (v > 0) {
            final diasEntreTrocas = (30 / v).round();
            diasParaTroca = diasEntreTrocas;
            proximaTroca =
                DateTime.now().add(Duration(days: diasEntreTrocas));
            _atualizarDatasDeNocalendario(diasEntreTrocas);
          }
        });
      }

      // NOVO: carregar temperatura ideal salva
      final snapTempIdeal =
          await _dbRef.child('glub1/temperatura/set').get();
      if (snapTempIdeal.exists && snapTempIdeal.value != null) {
        final v = (snapTempIdeal.value as num).toDouble();
        setState(() {
          tempIdeal = v;
          _ctrlTempIdeal.text = '$v';
        });
      }

      // Carregar tarefas concluídas
      final snapTarefas =
          await _dbRef.child('glub1/tarefas_concluidas').get();
      if (snapTarefas.exists && snapTarefas.value != null) {
        final Map<dynamic, dynamic> dados =
            snapTarefas.value as Map<dynamic, dynamic>;
        setState(() {
          for (final entry in dados.entries) {
            final partes = entry.key.toString().split('-');
            if (partes.length != 3) continue;
            final chave = DateTime.utc(
              int.parse(partes[0]),
              int.parse(partes[1]),
              int.parse(partes[2]),
            );
            final nomesConcluidos = List<String>.from(
              (entry.value as Map<dynamic, dynamic>)
                  .values
                  .map((v) => v.toString()),
            );
            if (tarefas[chave] != null) {
              for (final tarefa in tarefas[chave]!) {
                if (nomesConcluidos.contains(tarefa.nome)) {
                  tarefa.concluida = true;
                }
              }
            }
            for (final nome in nomesConcluidos) {
              final jaExiste =
                  tarefas[chave]?.any((t) => t.nome == nome) ?? false;
              if (!jaExiste) {
                tarefas.putIfAbsent(chave, () => []);
                tarefas[chave]!
                    .add(TarefaCalendario(nome: nome, concluida: true));
              }
            }
          }
        });
      }

      // NOVO: carregar tarefas criadas pelo usuário
      await _carregarTarefasUsuario();
    } catch (e) {
      debugPrint('Erro ao carregar dados do Firebase: $e');
    }
  }

  // ======================================================
  // NOVO: CARREGAR TAREFAS DO USUÁRIO DO FIREBASE
  // ======================================================

  Future<void> _carregarTarefasUsuario() async {
    try {
      final snap = await _dbRef.child('glub1/tarefas_usuario').get();
      if (!snap.exists || snap.value == null) return;

      final Map<dynamic, dynamic> dados =
          snap.value as Map<dynamic, dynamic>;

      setState(() {
        for (final entry in dados.entries) {
          final partes = entry.key.toString().split('-');
          if (partes.length != 3) continue;
          final chave = DateTime.utc(
            int.parse(partes[0]),
            int.parse(partes[1]),
            int.parse(partes[2]),
          );

          final tarefasMap = entry.value as Map<dynamic, dynamic>;
          for (final t in tarefasMap.values) {
            final tMap = t as Map<dynamic, dynamic>;
            final nome = tMap['nome']?.toString() ?? '';
            final concluida = tMap['concluida'] == true;
            if (nome.isEmpty) continue;

            final jaExiste = tarefas[chave]?.any((x) => x.nome == nome) ?? false;
            if (!jaExiste) {
              tarefas.putIfAbsent(chave, () => []);
              tarefas[chave]!.add(TarefaCalendario(
                nome: nome,
                concluida: concluida,
                isUsuario: true,
              ));
            }
          }
        }
      });
    } catch (e) {
      debugPrint('Erro ao carregar tarefas do usuário: $e');
    }
  }


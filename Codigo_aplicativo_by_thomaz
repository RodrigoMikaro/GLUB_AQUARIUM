// ======================================================
// COMPONENTE CUSTOMIZADO: CARTÃO SENSOR (temperatura intraday)
// CORRIGIDO: padding nas bordas do gráfico
// ======================================================

class CartaoSensor extends StatelessWidget {
  final String titulo;
  final String valor;
  final String unidade;
  final String subtitulo;
  final IconData icone;
  final List<LeituraTemp> historicoTemp;

  const CartaoSensor({
    super.key,
    required this.titulo,
    required this.valor,
    required this.unidade,
    required this.subtitulo,
    required this.icone,
    required this.historicoTemp,
  });

  @override
  Widget build(BuildContext context) {
    // CORRIGIDO: calcular min/max com padding de 0.5°C
    double minY = 23.0;
    double maxY = 29.0;
    if (historicoTemp.isNotEmpty) {
      final valores = historicoTemp.map((e) => e.valor).toList();
      final minV = valores.reduce((a, b) => a < b ? a : b);
      final maxV = valores.reduce((a, b) => a > b ? a : b);
      minY = (minV - 0.5);
      maxY = (maxV + 0.5);
      if ((maxY - minY) < 1.0) {
        minY -= 0.5;
        maxY += 0.5;
      }
    }

    return Container(
      padding: const EdgeInsets.all(22),
      decoration: cardDecoration(),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          Row(
            children: [
              Icon(icone, color: const Color(0xFF00D1FF)),
              const SizedBox(width: 10),
              Text(
                titulo,
                style: GoogleFonts.inter(
                    fontSize: 20, fontWeight: FontWeight.bold),
              ),
            ],
          ),
          const SizedBox(height: 6),
          Text(
            "Leituras das últimas horas (intervalo: 20 min)",
            style: TextStyle(
                color: Colors.white.withOpacity(.5), fontSize: 13),
          ),
          const SizedBox(height: 24),
          SizedBox(
            height: 200,
            child: historicoTemp.isEmpty
                ? Center(
                    child: Text(
                      "Aguardando dados do sensor...",
                      style: TextStyle(
                          color: Colors.white.withOpacity(.4)),
                    ),
                  )
                : LineChart(
                    LineChartData(
                      gridData: const FlGridData(show: false),
                      titlesData: FlTitlesData(
                        leftTitles: const AxisTitles(
                            sideTitles: SideTitles(showTitles: false)),
                        topTitles: const AxisTitles(
                            sideTitles: SideTitles(showTitles: false)),
                        rightTitles: const AxisTitles(
                            sideTitles: SideTitles(showTitles: false)),
                        bottomTitles: AxisTitles(
                          sideTitles: SideTitles(
                            showTitles: true,
                            reservedSize: 22,
                            interval: 1,
                            getTitlesWidget: (value, meta) {
                              int idx = value.toInt();
                              if (idx >= 0 &&
                                  idx < historicoTemp.length) {
                                bool mostrar = false;
                                if (historicoTemp.length <= 4) {
                                  mostrar = true;
                                } else {
                                  int meio =
                                      (historicoTemp.length / 2).floor();
                                  if (idx == 0 ||
                                      idx == meio ||
                                      idx == historicoTemp.length - 1) {
                                    mostrar = true;
                                  }
                                }
                                if (mostrar) {
                                  final DateTime horario =
                                      historicoTemp[idx].horario;
                                  return Padding(
                                    padding:
                                        const EdgeInsets.only(top: 6),
                                    child: Text(
                                      '${horario.hour.toString().padLeft(2, '0')}:${horario.minute.toString().padLeft(2, '0')}',
                                      style: const TextStyle(
                                        color: Colors.white38,
                                        fontSize: 10,
                                        fontWeight: FontWeight.w500,
                                      ),
                                    ),
                                  );
                                }
                              }
                              return const SizedBox();
                            },
                          ),
                        ),
                      ),
                      borderData: FlBorderData(show: false),
                      minX: 0,
                      maxX: (historicoTemp.length - 1).toDouble(),
                      minY: minY,
                      maxY: maxY,
                      lineBarsData: [
                        LineChartBarData(
                          spots: historicoTemp
                              .asMap()
                              .entries
                              .map((e) => FlSpot(
                                  e.key.toDouble(), e.value.valor))
                              .toList(),
                          isCurved: true,
                          color: const Color(0xFF00D1FF),
                          barWidth: 3,
                          isStrokeCapRound: true,
                          dotData: const FlDotData(show: true),
                          belowBarData: BarAreaData(
                            show: true,
                            color:
                                const Color(0xFF00D1FF).withOpacity(0.1),
                          ),
                        ),
                      ],
                    ),
                  ),
          ),
        ],
      ),
    );
  }
}


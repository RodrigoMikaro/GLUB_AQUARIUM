class MQTTService {
  late MqttBrowserClient client;
  Function(double temp)? onTemperatura;
  Function(double volts)? onVoltagem;
  Function(double ph)? onPh;
  Function(bool conectado)? onEsp32Status;

  static const String _host =
      'wss://0e6bf66e693b43c2a87b5cd707fe5647.s1.eu.hivemq.cloud/mqtt';
  static const int _port = 8884;
  static const String _username = 'glub1';
  static const String _password = 'GlubAquarium1';
  static const String _topicoTemp = 'glub1/temperatura';
  static const String _topicoVolt = 'glub1/voltagem';
  static const String _topicoPh = 'glub1/ph';
  static const String _topicoAlimentacaoFreq = 'glub1/alimentacao/frequencia';
  static const String _topicoAlimentacaoAgora = 'glub1/alimentacao/agora';
  static const String _topicoTroca = 'glub1/troca';
  static const String _topicoTrocaAgora = 'glub1/troca/agora';
  static const String _topicoLed = 'glub1/iluminacao';
  static const String _topicoTempAgr = 'glub1/temperatura/set';
  bool get isConnected =>
      client.connectionStatus?.state == MqttConnectionState.connected;

  Future<void> connect() async {
    client = MqttBrowserClient.withPort(_host, 'glub_flutter', _port);
    client.keepAlivePeriod = 20;
    client.logging(on: true);
    client.setProtocolV311();

    final connMess = MqttConnectMessage()
        .withClientIdentifier(
            'glub_flutter_${DateTime.now().millisecondsSinceEpoch}')
        .authenticateAs(_username, _password)
        .startClean();

    client.connectionMessage = connMess;

    try {
      await client.connect();
    } catch (e) {
      debugPrint('MQTT erro de conexão: $e');
      client.disconnect();
      return;
    }

    if (isConnected) {
      debugPrint('MQTT conectado ao HiveMQ');
      _assinar();
    } else {
      debugPrint('MQTT falhou: ${client.connectionStatus}');
    }
  }

  void _assinar() {
    client.subscribe(_topicoTemp, MqttQos.atLeastOnce);
    client.subscribe(_topicoVolt, MqttQos.atLeastOnce);
    client.subscribe(_topicoPh, MqttQos.atLeastOnce);

    client.updates!.listen((mensagens) {
      final msg = mensagens[0];
      final topico = msg.topic;
      final recMess = msg.payload as MqttPublishMessage;
      final payload = MqttPublishPayload.bytesToStringAsString(
        recMess.payload.message,
      ).trim();

      debugPrint('MQTT [$topico] payload: $payload');

      onEsp32Status?.call(true);

      try {
        final valor = double.parse(payload);
        if (topico == "glub1/temperatura") {
          if (onTemperatura != null) onTemperatura!(valor);
          _dbRef.child("glub1/temperatura_atual").set(valor);
        } else if (topico == "glub1/voltagem") {
          if (onVoltagem != null) onVoltagem!(valor);
          _dbRef.child("glub1/voltagem_atual").set(valor);
        } else if (topico == "glub1/ph") {
          if (onPh != null) onPh!(valor);
          _dbRef.child("glub1/ph_atual").set(valor);
        }
      } catch (e) {
        debugPrint('Erro ao parsear payload MQTT: $e — payload: $payload');
      }
    });
  }

  void publicarFrequenciaAlimentacao(int vezesPorDia) {
    if (!isConnected) return;
    final builder = MqttClientPayloadBuilder();
    builder.addString('$vezesPorDia');
    client.publishMessage(
        _topicoAlimentacaoFreq, MqttQos.atLeastOnce, builder.payload!);
  }
  void publicarTemperatura(double tempIdeal) {
    if (!isConnected) return;
    final builder = MqttClientPayloadBuilder();
    builder.addString('$tempIdeal');
    client.publishMessage(
        _topicoTempAgr, MqttQos.atLeastOnce, builder.payload!);
  }

  void publicarAlimentacaoAgora() {
    if (!isConnected) return;
    final builder = MqttClientPayloadBuilder();
    builder.addString('1');
    client.publishMessage(
        _topicoAlimentacaoAgora, MqttQos.atLeastOnce, builder.payload!);
  }

  void publicarFrequenciaTroca(int vezesPorMes) {
    if (!isConnected) return;
    final builder = MqttClientPayloadBuilder();
    builder.addString('$vezesPorMes');
    client.publishMessage(
        _topicoTroca, MqttQos.atLeastOnce, builder.payload!);
  }

  void publicarTrocaAgora() {
    if (!isConnected) return;
    final builder = MqttClientPayloadBuilder();
    builder.addString('1');
    client.publishMessage(
        _topicoTrocaAgora, MqttQos.atLeastOnce, builder.payload!);
  }

  void publicarLed(int intensidade) {
    if (!isConnected) return;
    final builder = MqttClientPayloadBuilder();
    builder.addString('$intensidade');
    client.publishMessage(
        _topicoLed, MqttQos.atLeastOnce, builder.payload!);
  }

  void desconectar() => client.disconnect();
}


  Widget _cartaoHistoricoSemanalPh() {
    const corManha = Color(0xFF00FFB3);
    const corTarde = Color(0xFFFFB347);
    const corNoite = Color(0xFFBB86FC);
    const diasSemana = ['Dom', 'Seg', 'Ter', 'Qua', 'Qui', 'Sex', 'Sáb'];

    List<FlSpot> spotsManha = [];
    List<FlSpot> spotsTarde = [];
    List<FlSpot> spotsNoite = [];

    for (int i = 0; i < _historicoSemanalPh.length; i++) {
      final l = _historicoSemanalPh[i];
      if (l.mediaManha > 0) spotsManha.add(FlSpot(i.toDouble(), l.mediaManha));
      if (l.mediaTarde > 0) spotsTarde.add(FlSpot(i.toDouble(), l.mediaTarde));
      if (l.mediaNoite > 0) spotsNoite.add(FlSpot(i.toDouble(), l.mediaNoite));
    }

    final todosValores = [
      ...spotsManha.map((s) => s.y),
      ...spotsTarde.map((s) => s.y),
      ...spotsNoite.map((s) => s.y),
    ];

    // Padding de 0.3 pH acima e abaixo
    double minY = 5.5;
    double maxY = 9.0;
    if (todosValores.isNotEmpty) {
      final minV = todosValores.reduce((a, b) => a < b ? a : b);
      final maxV = todosValores.reduce((a, b) => a > b ? a : b);
      minY = (minV - 0.3).clamp(0.0, 14.0);
      maxY = (maxV + 0.3).clamp(0.0, 14.0);
      if ((maxY - minY) < 0.5) {
        minY -= 0.25;
        maxY += 0.25;
      }
      // Arredonda para múltiplos de 0.25 para labels bonitas
      minY = (minY * 4).floor() / 4;
      maxY = (maxY * 4).ceil() / 4;
    }

    return Container(
      padding: const EdgeInsets.all(22),
      decoration: cardDecoration(),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [

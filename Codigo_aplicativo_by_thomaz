  void _salvarTarefasUsuario(DateTime dia) {
    final chave = _chaveData(dia);
    final diaNormalizado = DateTime.utc(dia.year, dia.month, dia.day);
    final tarefasUsuario = tarefas[diaNormalizado]
            ?.where((t) => t.isUsuario)
            .toList() ??
        [];

    if (tarefasUsuario.isEmpty) {
      _dbRef.child('glub1/tarefas_usuario/$chave').remove();
      return;
    }

    final Map<String, Map<String, dynamic>> dados = {};
    for (int i = 0; i < tarefasUsuario.length; i++) {
      dados['$i'] = {
        'nome': tarefasUsuario[i].nome,
        'concluida': tarefasUsuario[i].concluida,
      };
    }
    _dbRef.child('glub1/tarefas_usuario/$chave').set(dados);
  }


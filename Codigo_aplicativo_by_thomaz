  // ======================================================
  // HELPERS CALENDÁRIO
  // ======================================================

  void _atualizarDatasDeNocalendario(int frequencia) {
    final chaves = tarefas.keys.toList();
    for (final chave in chaves) {
      tarefas[chave]
          ?.removeWhere((t) => t.nome == "Troca de água (automática)");
      if (tarefas[chave]?.isEmpty ?? false) {
        tarefas.remove(chave);
      }
    }

    final hoje = DateTime.now();
    for (int i = 1; i <= (90 ~/ frequencia); i++) {
      final dataTraca = hoje.add(Duration(days: frequencia * i));
      final chave =
          DateTime.utc(dataTraca.year, dataTraca.month, dataTraca.day);
      tarefas.putIfAbsent(chave, () => []);
      if (!tarefas[chave]!
          .any((t) => t.nome == "Troca de água (automática)")) {
        tarefas[chave]!
            .insert(0, TarefaCalendario(nome: "Troca de água (automática)"));
      }
    }
  }

  // ======================================================
  // ALERTAS
  // ======================================================

  List<ItemAlerta> get _alertasCalendario {
    final hoje = DateTime.now();
    final List<ItemAlerta> gerados = [];

    for (int d = 0; d <= 14; d++) {
      final dia = hoje.add(Duration(days: d));
      final chave = DateTime.utc(dia.year, dia.month, dia.day);
      final lista = tarefas[chave];
      if (lista == null || lista.isEmpty) continue;

      for (final tarefa in lista) {
        if (tarefa.concluida) continue;

        final TipoAlerta tipo;
        final String tempo;
        if (d == 0) {
          tipo = TipoAlerta.critico;
          tempo = "hoje";
        } else if (d == 1) {
          tipo = TipoAlerta.aviso;
          tempo = "amanhã";
        } else if (d <= 3) {
          tipo = TipoAlerta.aviso;
          tempo = "em $d dias";
        } else {
          tipo = TipoAlerta.info;
          tempo = "em $d dias";
        }

        gerados.add(ItemAlerta(
          titulo: tarefa.nome,
          descricao: "Agendado para ${_formatarData(dia)}",
          tempo: tempo,
          tipo: tipo,
        ));
      }
    }

    if (_estadoVoltagem == _EstadoVoltagem.critico) {
      gerados.insert(
        0,
        ItemAlerta(
          titulo: "Tensão crítica detectada",
          descricao:
              "Voltagem em ${voltagemInstantanea.toStringAsFixed(1)} V. Verifique a fonte de alimentação.",
          tempo: "agora",
          tipo: TipoAlerta.critico,
        ),
      );
    }

    if (!esp32Conectado) {
      gerados.insert(
        0,
        ItemAlerta(
          titulo: "ESP32 desconectado",
          descricao: "Nenhuma mensagem recebida do dispositivo.",
          tempo: "agora",
          tipo: TipoAlerta.critico,
        ),
      );
    }

    return gerados;
  }


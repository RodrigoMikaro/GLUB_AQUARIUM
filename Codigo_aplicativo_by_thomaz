  // ======================================================
  // ATUALIZA HISTÓRICO SEMANAL DE TEMPERATURA
  // ======================================================

  void _atualizarHistoricoSemanal(DateTime agora) {
    final diaAtual = DateTime(agora.year, agora.month, agora.day);
    final idx = _historicoSemanal.indexWhere((l) =>
        l.dia.year == diaAtual.year &&
        l.dia.month == diaAtual.month &&
        l.dia.day == diaAtual.day);

    final double? mediaManha = _bufferManha.isNotEmpty
        ? _bufferManha.reduce((a, b) => a + b) / _bufferManha.length
        : null;
    final double? mediaTarde = _bufferTarde.isNotEmpty
        ? _bufferTarde.reduce((a, b) => a + b) / _bufferTarde.length
        : null;
    final double? mediaNoite = _bufferNoite.isNotEmpty
        ? _bufferNoite.reduce((a, b) => a + b) / _bufferNoite.length
        : null;

    final existente = idx >= 0 ? _historicoSemanal[idx] : null;

    final novaLeitura = LeituraDiaria(
      mediaManha: mediaManha ?? existente?.mediaManha ?? 0,
      mediaTarde: mediaTarde ?? existente?.mediaTarde ?? 0,
      mediaNoite: mediaNoite ?? existente?.mediaNoite ?? 0,
      dia: diaAtual,
    );

    if (idx >= 0) {
      _historicoSemanal[idx] = novaLeitura;
    } else {
      _historicoSemanal.add(novaLeitura);
      if (_historicoSemanal.length > 7) _historicoSemanal.removeAt(0);
    }

    final chave = _chaveData(diaAtual);
    final Map<String, double> dadosSalvar = {};
    if (mediaManha != null) dadosSalvar['manha'] = mediaManha;
    if (mediaTarde != null) dadosSalvar['tarde'] = mediaTarde;
    if (mediaNoite != null) dadosSalvar['noite'] = mediaNoite;
    if (dadosSalvar.isNotEmpty) {
      _dbRef.child('glub1/historico_semanal/$chave').update(dadosSalvar);
    }
  }


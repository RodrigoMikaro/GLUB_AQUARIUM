  // ======================================================

  Widget _cartaoHistoricoPh() {
    const corPh = Color(0xFF00FFB3);

    // CORRIGIDO: calcular min/max com padding
    double minY = 5.5;
    double maxY = 9.0;
    if (_historicoPh.isNotEmpty) {
      final valores = _historicoPh.map((e) => e.valor).toList();
      final minV = valores.reduce((a, b) => a < b ? a : b);
      final maxV = valores.reduce((a, b) => a > b ? a : b);
      minY = (minV - 0.3).clamp(0.0, 14.0);
      maxY = (maxV + 0.3).clamp(0.0, 14.0);
      if ((maxY - minY) < 0.5) {
        minY -= 0.25;
        maxY += 0.25;
      }
    }

    return Container(
      padding: const EdgeInsets.all(22),
      decoration: cardDecoration(),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          Row(
            children: [

  // ======================================================

  Widget _cartaoHistoricoSemanal() {
    const corManha = Color(0xFF00D1FF);
    const corTarde = Color(0xFF00FFB3);
    const corNoite = Color(0xFF7B61FF);
    const diasSemana = ['Dom', 'Seg', 'Ter', 'Qua', 'Qui', 'Sex', 'Sáb'];

    List<FlSpot> spotsManha = [];
    List<FlSpot> spotsTarde = [];
    List<FlSpot> spotsNoite = [];

    for (int i = 0; i < _historicoSemanal.length; i++) {
      final l = _historicoSemanal[i];
      if (l.mediaManha > 0) spotsManha.add(FlSpot(i.toDouble(), l.mediaManha));
      if (l.mediaTarde > 0) spotsTarde.add(FlSpot(i.toDouble(), l.mediaTarde));
      if (l.mediaNoite > 0) spotsNoite.add(FlSpot(i.toDouble(), l.mediaNoite));
    }

    final todosValores = [
      ...spotsManha.map((s) => s.y),
      ...spotsTarde.map((s) => s.y),
      ...spotsNoite.map((s) => s.y),
    ];

    // CORRIGIDO: padding explícito de 0.5°C em cima e embaixo
    double minY = 23.0;
    double maxY = 29.0;
    if (todosValores.isNotEmpty) {
      final minV = todosValores.reduce((a, b) => a < b ? a : b);
      final maxV = todosValores.reduce((a, b) => a > b ? a : b);
      minY = (minV - 0.5);
      maxY = (maxV + 0.5);
      if ((maxY - minY) < 1.0) {
        minY -= 0.5;
        maxY += 0.5;
      }
      // Arredonda para múltiplos de 0.5 para labels bonitas
      minY = (minY * 2).floor() / 2;
      maxY = (maxY * 2).ceil() / 2;
    }

    return Container(
      padding: const EdgeInsets.all(22),
      decoration: cardDecoration(),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          Row(
            children: [
              const Icon(LucideIcons.calendarDays,
                  color: Color(0xFF00D1FF)),

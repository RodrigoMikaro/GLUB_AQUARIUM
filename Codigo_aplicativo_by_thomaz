class _DashboardPageState extends State<DashboardPage> {
  final mqtt = MQTTService();

  int? intensidadeLed;
  final TextEditingController _ctrlLed = TextEditingController();

  int? frequenciaAlimentacao;
  final TextEditingController _ctrlAlimentacao = TextEditingController();

  void _mostrarDetalhesDia(DateTime dia) {
    final diaNormalizado = DateTime.utc(dia.year, dia.month, dia.day);
    final controller = TextEditingController();

    showModalBottomSheet(
      context: context,
      backgroundColor: const Color(0xFF08283A),
      shape: const RoundedRectangleBorder(
        borderRadius: BorderRadius.vertical(top: Radius.circular(28)),
      ),
      isScrollControlled: true,
      builder: (context) {
        return Padding(
          padding: EdgeInsets.only(
            left: 24,
            right: 24,
            top: 24,
            bottom: MediaQuery.of(context).viewInsets.bottom + 24,
          ),
          child: StatefulBuilder(
            builder: (context, modalSetState) {
              final tarefasDia = tarefas[diaNormalizado] ?? [];

              return Column(
                mainAxisSize: MainAxisSize.min,
                crossAxisAlignment: CrossAxisAlignment.start,
                children: [
                  Center(
                    child: Container(
                      width: 40,
                      height: 4,
                      margin: const EdgeInsets.only(bottom: 20),
                      decoration: BoxDecoration(
                        color: Colors.white24,
                        borderRadius: BorderRadius.circular(4),
                      ),
                    ),
                  ),
                  Text(
                    "Detalhes do Dia",
                    style: GoogleFonts.inter(
                        fontSize: 26, fontWeight: FontWeight.bold),
                  ),
                  const SizedBox(height: 4),
                  Text(
                    "${dia.day}/${dia.month}/${dia.year}",
                    style: TextStyle(
                        color: Colors.white.withOpacity(.6)),
                  ),
                  const SizedBox(height: 24),

                  if (tarefasDia.isEmpty)
                    Padding(
                      padding: const EdgeInsets.only(bottom: 16),
                      child: Text(
                        "Nenhuma tarefa para este dia.",
                        style: TextStyle(
                            color: Colors.white.withOpacity(.4),
                            fontSize: 14),
                      ),
                    ),

                  ...tarefasDia.asMap().entries.map((entry) {
                    final tarefa = entry.value;
                    final isAutomatica =
                        tarefa.nome == "Troca de água (automática)";
                    return Container(
                      margin: const EdgeInsets.only(bottom: 10),
                      padding: const EdgeInsets.symmetric(
                          horizontal: 16, vertical: 14),
                      decoration: BoxDecoration(
                        color: tarefa.concluida
                            ? Colors.greenAccent.withOpacity(.08)
                            : isAutomatica
                                ? const Color(0xFF00D1FF).withOpacity(.06)
                                : const Color(0xFF0A3247),
                        borderRadius: BorderRadius.circular(16),
                        border: tarefa.concluida
                            ? Border.all(
                                color: Colors.greenAccent
                                    .withOpacity(.3))
                            : isAutomatica
                                ? Border.all(
                                    color: const Color(0xFF00D1FF)
                                        .withOpacity(.25))
                                : null,
                      ),
                      child: Row(
                        children: [
                          GestureDetector(
                            onTap: () {
                              modalSetState(() {
                                tarefa.concluida = !tarefa.concluida;
                              });
                              setState(() {});
                              _salvarTarefasConcluidas(dia);
                              // NOVO: se for tarefa do usuário, atualiza status
                              if (tarefa.isUsuario) {
                                _salvarTarefasUsuario(dia);
                              }
                            },
                            child: AnimatedContainer(
                              duration:
                                  const Duration(milliseconds: 200),
                              width: 26,
                              height: 26,
                              decoration: BoxDecoration(
                                color: tarefa.concluida
                                    ? Colors.greenAccent
                                    : Colors.transparent,
                                borderRadius:
                                    BorderRadius.circular(8),
                                border: Border.all(
                                  color: tarefa.concluida
                                      ? Colors.greenAccent
                                      : Colors.white38,
                                  width: 2,
                                ),
                              ),
                              child: tarefa.concluida
                                  ? const Icon(Icons.check,
                                      size: 16, color: Colors.black)
                                  : null,
                            ),
                          ),
                          const SizedBox(width: 14),
                          Expanded(
                            child: Row(
                              children: [
                                if (isAutomatica) ...[
                                  const Icon(LucideIcons.droplets,
                                      size: 14,
                                      color: Color(0xFF00D1FF)),
                                  const SizedBox(width: 6),
                                ],
                                // NOVO: ícone para tarefas do usuário
                                if (tarefa.isUsuario &&
                                    !isAutomatica) ...[
                                  Icon(LucideIcons.userCheck,
                                      size: 14,
                                      color: Colors.white38),
                                  const SizedBox(width: 6),
                                ],
                                Expanded(
                                  child: Text(
                                    tarefa.nome,
                                    style: GoogleFonts.inter(
                                      fontSize: 14,
                                      fontWeight: FontWeight.w500,
                                      color: tarefa.concluida
                                          ? Colors.white38
                                          : isAutomatica
                                              ? const Color(0xFF00D1FF)
                                              : Colors.white,
                                      decoration: tarefa.concluida
                                          ? TextDecoration.lineThrough
                                          : null,
                                      decorationColor: Colors.white38,
                                    ),
                                  ),
                                ),
                              ],
                            ),
                          ),
                          if (tarefa.concluida)
                            Container(
                              padding: const EdgeInsets.symmetric(
                                  horizontal: 8, vertical: 3),
                              decoration: BoxDecoration(
                                color: Colors.greenAccent
                                    .withOpacity(.15),
                                borderRadius:
                                    BorderRadius.circular(8),
                              ),
                              child: Text(
                                "Concluída",
                                style: GoogleFonts.inter(
                                  fontSize: 11,
                                  color: Colors.greenAccent,
                                  fontWeight: FontWeight.w600,
                                ),
                              ),
                            ),
                        ],
                      ),
                    );
                  }),

                  const SizedBox(height: 8),
                  TextField(
                    controller: controller,
                    decoration: InputDecoration(
                      hintText: "Adicionar nova tarefa...",
                      filled: true,
                      fillColor: const Color(0xFF0B3247),
                      border: OutlineInputBorder(
                        borderRadius: BorderRadius.circular(18),
                        borderSide: BorderSide.none,
                      ),
                    ),
                  ),
                  const SizedBox(height: 14),
                  SizedBox(
                    width: double.infinity,
                    child: ElevatedButton.icon(
                      style: ElevatedButton.styleFrom(
                        backgroundColor: const Color(0xFF00D1FF),
                        foregroundColor: Colors.black,
                        padding:
                            const EdgeInsets.symmetric(vertical: 14),
                        shape: RoundedRectangleBorder(
                          borderRadius: BorderRadius.circular(16),
                        ),
                      ),
                      onPressed: () {
                        if (controller.text.trim().isEmpty) return;
                        final novaTarefa = TarefaCalendario(
                          nome: controller.text.trim(),
                          isUsuario: true, // NOVO: marca como tarefa do usuário
                        );
                        setState(() {
                          tarefas.putIfAbsent(diaNormalizado, () => []);
                          tarefas[diaNormalizado]!.add(novaTarefa);
                        });
                        // NOVO: persiste no Firebase imediatamente
                        _salvarTarefasUsuario(dia);
                        Navigator.pop(context);
                      },
                      icon: const Icon(Icons.add),
                      label: const Text("Adicionar tarefa"),
                    ),
                  ),
                ],
              );
            },
          ),
        );
      },
    );
  }
